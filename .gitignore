# Keep only the game project folders in Git
*
!.gitignore
!cocos/
!cocos/**
!cocos-project/
!cocos-project/**
!preview/
!preview/**
!magic-castle/
!magic-castle/**

# Local caches and editor/build output
preview/__pycache__/
cocos-project/library/
cocos-project/temp/
cocos-project/build/
cocos-project/deploy/
cocos-project/
magic-castle/.creator/
magic-castle/build/
magic-castle/library/
magic-castle/profiles/
magic-castle/temp/
